{
  "name": "scout-backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["scout-backend"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "dependsOn": ["scout-backend:build", "scout-backend:serve"],
      "options": {
        "jestConfig": "apps/scout-backend-e2e/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
