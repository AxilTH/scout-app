{
  "name": "scout-app",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve scout-frontend",
    "start:frontend": "nx serve scout-frontend",
    "start:backend": "nx serve scout-backend",
    "start:all": "nx run-many -t serve -p scout-frontend,scout-backend --parallel",
    "build": "nx run-many -t build -p scout-frontend,scout-backend",
    "build:frontend": "nx build scout-frontend",
    "build:backend": "nx build scout-backend",
    "watch": "nx build scout-frontend --watch --configuration development",
    "serve:ssr": "node dist/apps/scout-frontend/server/server.mjs",
    "test": "nx run-many -t test -p scout-frontend,scout-backend",
    "test:frontend": "nx test scout-frontend",
    "test:backend": "nx test scout-backend",
    "test:e2e": "nx e2e scout-backend-e2e",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f postgres",
    "docker:dev:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:init:dry": "prisma db init --dry-run",
    "db:setup": "npm run db:emit && npm run db:init",
    "dev:setup": "npm run docker:dev && npm run db:setup",
    "graph": "nx graph"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "axios": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.8",
    "@angular-devkit/schematics": "^22.1.8",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "^23.2.1",
    "@nx/node": "^23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@prisma/cli-engine": "^0.4.0",
    "@schematics/angular": "^22.1.8",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^5.0.1",
    "@types/jest": "~30.0.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsdom": "^28.0.0",
    "nx": "23.2.1",
    "prettier": "^3.8.1",
    "prisma": "^8.0.0-rc.15",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
